// RUN: cir-opt %s | cir-opt | FileCheck %s

// Round-trip of the !cir.ptr data layout entry (#cir.ptr_spec) in a module
// dlti.dl_spec. Only the default address space is supported for now.

// CHECK: module attributes
// CHECK-SAME: !cir.ptr<!cir.void> = #cir.ptr_spec<size = 32, abi = 32, preferred = 32, index = 32>
module attributes {
  dlti.dl_spec = #dlti.dl_spec<
    #dlti.dl_entry<!cir.ptr<!cir.void>,
                   #cir.ptr_spec<size = 32, abi = 32, preferred = 32, index = 32>>
  >
} {
  cir.func @f() {
    cir.return
  }
}
